# Optional OpenSky API client credentials (OAuth2 client-credentials flow).
# Create them at https://opensky-network.org/my-opensky/account -> "API client".
# These are only read by the server-side proxy (src/lib/opensky-server.ts) and
# are never shipped to the browser. Without them the app uses anonymous access.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
